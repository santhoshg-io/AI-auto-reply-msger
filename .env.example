# ==============================================================================
# AI AUTOMATIC EMAIL REPLY AGENT - CONFIGURATION (GROQ POWERED)
# ==============================================================================

# AI Provider Configuration (Default: Groq)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Owner Persona & Preferences
USER_NAME=Santhosh
USER_ROLE=Software Engineer & AI Researcher
DEFAULT_REPLY_TONE=professional
# Tone choices: professional | friendly | concise | formal

# Decision & Automation Controls
# Set to 'true' to automatically send replies when an email is received and verified safe
AUTO_REPLY_ENABLED=true
MIN_CONFIDENCE_THRESHOLD=0.75
DAILY_AUTO_REPLY_LIMIT=50
POLL_INTERVAL_SECONDS=60

# Gmail API Configuration
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Database Configuration
DATABASE_URL=sqlite:///./email_agent.db

# Environment mode: development | production
ENVIRONMENT=development
